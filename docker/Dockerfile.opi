# ============================================
# Dockerfile Orange Pi PC+:  ROS Noetic
# Build trên OPi (ARM): docker build -t synmech_ros .
# ============================================
FROM ros:noetic-ros-base

# Skip timezone while installing package
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # ROS packages
    ros-noetic-robot-state-publisher \
    ros-noetic-xacro \
    ros-noetic-tf \
    ros-noetic-nav-msgs \
    ros-noetic-geometry-msgs \
    ros-noetic-move-base \
    ros-noetic-amcl \
    ros-noetic-map-server \
    ros-noetic-gmapping \
    ros-noetic-teleop-twist-keyboard \
    ros-noetic-rplidar-ros \
    # Python3 cho base_controller
    python3-serial \
    python3-pip \
    # Tools
    vim \
    iputils-ping \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Make catkin workspace
RUN mkdir -p /catkin_ws/src
WORKDIR /catkin_ws

# Copy source code into container
# (mount volume in docker-compose)

# Setup .bashrc for interactive shells (docker exec, docker-compose run)
RUN echo "source /opt/ros/noetic/setup.bash" >> /root/.bashrc && \
    echo "if [ -f /catkin_ws/devel/setup.bash ]; then source /catkin_ws/devel/setup.bash; fi" >> /root/.bashrc && \
    echo '# ROS network — sử dụng biến từ env_file (network.env)' >> /root/.bashrc && \
    echo 'export ROS_MASTER_URI=${ROS_MASTER_URI:-http://${OPI_IP:-localhost}:${ROS_PORT:-11311}}' >> /root/.bashrc && \
    echo 'export ROS_IP=${ROS_IP:-${OPI_IP:-127.0.0.1}}' >> /root/.bashrc

# Entrypoint script
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
