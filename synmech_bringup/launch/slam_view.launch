<launch>
    <arg name="rviz_config" default="$(find synmech_bringup)/config/slam.rviz"/>

    <!-- RViz — Hiển thị robot, Lidar, bản đồ SLAM -->
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

    <!-- Teleop Keyboard — Lái xe từ xa bằng bàn phím
         Mở trong terminal riêng (xterm) để nhận phím bấm -->
    <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py"
          name="teleop" output="screen"
          launch-prefix="xterm -e">
        <!-- Giảm tốc độ mặc định cho robot nhỏ -->
        <param name="speed"      value="0.10"/>
        <param name="turn"       value="0.4"/>
    </node>
</launch>
