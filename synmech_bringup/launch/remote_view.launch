<launch>
    <!-- ============================================
         REMOTE VIEW — CHẠY TRÊN LAPTOP
         Kết nối vào ROS Master trên Orange Pi để:
         1. Xem dữ liệu Lidar, bản đồ, TF trên RViz
         2. Điều khiển xe bằng bàn phím (teleop)

         TRƯỚC KHI CHẠY, đọc cấu hình mạng:
           source ~/catkin_ws/src/synmech_mobot/network.env
           export ROS_MASTER_URI=http://${OPI_IP}:${ROS_PORT}
           export ROS_IP=${LAPTOP_IP}
         ============================================ -->

    <arg name="rviz_config" default="$(find synmech_sim)/config/sim.rviz"/>

    <!-- RViz — Hiển thị robot, Lidar, bản đồ -->
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(arg rviz_config)" output="screen"/>

    <!-- Teleop Keyboard — Lái xe từ xa bằng bàn phím
         Mở trong terminal riêng (xterm) để nhận phím bấm -->
    <node pkg="synmech_bringup" type="teleop_hold.py"
          name="teleop_hold" output="screen"
          launch-prefix="xterm -e">
        <!-- Giảm tốc độ mặc định cho robot nhỏ -->
        <param name="speed"      value="0.15"/>
        <param name="turn"       value="0.5"/>
        <param name="timeout"    value="0.15"/>
    </node>
</launch>
