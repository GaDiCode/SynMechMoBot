<launch>
    <!-- Bringup: URDF + robot_state_publisher + Lidar + fake_odom -->
    <include file="$(find synmech_bringup)/launch/bringup.launch" />

    <!-- Gmapping SLAM: Receives /scan + /odom -> Generates /map -->
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
        <!-- Frame references -->
        <param name="base_frame"  value="base_footprint"/>
        <param name="odom_frame"  value="odom"/>
        <param name="map_frame"   value="map"/>

        <!-- Map update interval -->
        <param name="map_update_interval" value="2.0"/>

        <!-- Conditions for Gmapping to update:
             The robot must move at least 0.1m OR rotate 0.1 rad
             to trigger scan matching. Smaller values = more frequent updates -->
        <param name="linearUpdate"   value="0.1"/>
        <param name="angularUpdate"  value="0.1"/>

        <!-- temporalUpdate: Forces an update every N seconds
             EVEN IF the robot hasn't moved according to odometry. 
             Crucial for Phase 1 where fake_odom doesn't know when the robot is manually moved.
             Value -1.0 = disabled (default). Set to 1.0 = update every 1 second.
             Switch back to -1.0 once real odometry (Phase 2+) is available to save CPU -->
        <param name="temporalUpdate" value="1.0"/>

        <!-- Lidar scan range -->
        <param name="maxUrange" value="6.0"/>
        <param name="maxRange"  value="8.0"/>

        <!-- Scan matching parameters (defaults are usually stable) -->
        <param name="sigma"       value="0.05"/>
        <param name="kernelSize"  value="1"/>
        <param name="lstep"       value="0.05"/>
        <param name="astep"       value="0.05"/>
        <param name="iterations"  value="5"/>
        <param name="lsigma"      value="0.075"/>
        <param name="ogain"       value="3.0"/>
        <param name="lskip"       value="0"/>

        <!-- minimumScore: Minimum score to accept a scan match.
             Lower value (50) = more permissive, good for Phase 1 with fake odometry.
             Increase to 200-400 with real odometry (Phase 2+) for a more accurate map -->
        <param name="minimumScore" value="50"/>

        <!-- Particle filter parameters -->
        <param name="srr" value="0.01"/>
        <param name="srt" value="0.02"/>
        <param name="str" value="0.01"/>
        <param name="stt" value="0.02"/>
        <param name="resampleThreshold" value="0.5"/>
        <param name="particles"  value="30"/>

        <!-- Initial map dimensions (20m x 20m) -->
        <param name="delta" value="0.05"/>
        <param name="xmin" value="-10.0"/>
        <param name="ymin" value="-10.0"/>
        <param name="xmax" value="10.0"/>
        <param name="ymax" value="10.0"/>

        <!-- Sampling parameters -->
        <param name="llsamplerange"  value="0.01"/>
        <param name="llsamplestep"   value="0.01"/>
        <param name="lasamplerange"  value="0.005"/>
        <param name="lasamplestep"   value="0.005"/>
    </node>
</launch>
