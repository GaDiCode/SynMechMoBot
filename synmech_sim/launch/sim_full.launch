<?xml version="1.0"?>
<launch>
    <!-- Arguments -->
    <arg name="world" default="simple_house"/>
    <arg name="rviz" default="true"/>
    <arg name="teleop" default="true"/>

    <!-- Robot Description -->
    <param name="robot_description"
           command="$(find xacro)/xacro '$(find synmech_description)/urdf/robot.urdf.xacro'"/>
    <param name="use_sim_time" value="true"/>

    <!-- Gazebo -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find synmech_sim)/worlds/$(arg world).world"/>
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <!-- Spawn Robot -->
    <node pkg="gazebo_ros" type="spawn_model" name="spawn_synmech"
          args="-urdf -model synmech_mobot -param robot_description -x 0 -y 0 -z 0.05"
          output="screen"/>

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" type="robot_state_publisher"
          name="robot_state_publisher" output="screen">
        <param name="publish_frequency" value="50.0"/>
    </node>

    <!-- RViz -->
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find synmech_sim)/config/sim.rviz" output="screen"/>

    <!-- Teleop Keyboard (in a separate terminal) -->
    <node if="$(arg teleop)" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py"
          name="teleop" output="screen"
          launch-prefix="xterm -e"/>
</launch>
